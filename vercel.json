{
  "buildCommand": "cd frontend && npm install --legacy-peer-deps && CI=false npx craco build",
  "outputDirectory": "frontend/build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rekapin-production-ba18.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
