# Salin jadi backend/.env lalu isi nilainya. JANGAN commit file .env.
# Semua variabel di bawah dibaca di app/config.py.

# --- Database (wajib) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=rekapin_dev

# --- Auth (wajib) ---
# JWT_SECRET: acak & panjang. Siapa pun yang tahu nilainya bisa membuat token
# login palsu. Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-nilai-acak-panjang
ADMIN_EMAIL=admin@perusahaan.com
ADMIN_PASSWORD=ganti-password-ini
ADMIN_NAME=Admin
# Isi true SEKALI kalau password admin lupa dan mau di-reset dari nilai di atas.
# ADMIN_PASSWORD_RESET=false

# --- Email (kosong = email tidak dikirim, hanya dicatat di log) ---
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_API_KEY_HEADER=X-Email-Key
EMAIL_FROM_NAME=Rekapin HR
PUBLIC_APP_URL=https://rekapin.perusahaan.com
HASAN_EMAIL=notifikasi@perusahaan.com
HASAN_NAME=Hasan

# --- Cron & CORS ---
# Kosong = endpoint cron dimatikan (503). Buat dengan: openssl rand -hex 32
WEBHOOK_CRON_SECRET=
# Daftar origin frontend, dipisah koma. 3000 = dev, 3001 = build produksi lokal.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Zona waktu kantor untuk filter "tanggal input" (7 = WIB) ---
LOCAL_UTC_OFFSET_HOURS=7
